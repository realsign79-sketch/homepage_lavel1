# 최종 도메인 (예: https://hyohyogrooming.com)
# 비어 있으면 canonical은 Vercel 기본 주소를 쓰고, robots.txt가 전체 색인을 차단합니다(미리보기 보호).
NEXT_PUBLIC_SITE_URL=

# 네이버 서치어드바이저 사이트 소유확인 content 값
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# Google Search Console HTML 태그 content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# GA4 측정 ID (예: G-XXXXXXXXXX) — 비어 있으면 분석 스크립트를 넣지 않습니다.
NEXT_PUBLIC_GA_ID=
